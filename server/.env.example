# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (Neon) Database URLs
# Pooled connection string (with PgBouncer)
POSTGRES_PRISMA_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct connection string (for migrations)
POSTGRES_URL_NON_POOLING="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://user:password@cluster0.sample.mongodb.net/hireready?retryWrites=true&w=majority"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="generate_at_least_32_char_secure_random_string_for_access_tokens"
JWT_REFRESH_SECRET="generate_at_least_32_char_secure_random_string_for_refresh_tokens"

# AI Provider Configuration ("mock" | "deepseek")
AI_PROVIDER=mock
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Judge0 Sandbox Configuration (optional / mock mode in dev)
JUDGE0_MOCK=true
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
