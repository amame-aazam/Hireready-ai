generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  OA_PENDING
  OA_PASSED
  OA_FAILED
  INTERVIEW_PENDING
  COMPLETED
  SELECTED
  WAITLISTED
  NOT_SELECTED
  REJECTED
}

enum InterviewType {
  DSA
  HR
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AssessmentState {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum QuestionType {
  MCQ
  CODING
}

enum InterviewStage {
  APPROACH
  CODING
  QUESTION
  FOLLOW_UP
  SUBMITTED
  COMPLETED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  studentProfile     StudentProfile?
  refreshTokens      RefreshToken[]
  applications       Application[]
  assessmentAttempts AssessmentAttempt[]
  interviewSessions  InterviewSession[]
  auditLogs          AuditLog[]

  @@index([role])
  @@map("users")
}

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  domainId        String?
  headline        String?
  githubUrl       String?
  linkedinUrl     String?
  preferredTech   String[]
  yearsExperience Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          Domain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([domainId])
  @@map("student_profiles")
}

model Domain {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  description     String
  icon            String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  studentProfiles StudentProfile[]
  applications    Application[]
  assessments     Assessment[]

  @@index([isActive])
  @@map("domains")
}

model RefreshToken {
  id              String   @id @default(uuid())
  tokenHash       String   @unique
  userId          String
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
  @@map("refresh_tokens")
}

model Application {
  id               String            @id @default(uuid())
  userId           String
  domainId         String?
  targetDomain     String
  status           ApplicationStatus @default(DRAFT)
  // UUID referencing MongoDB resume_analyses document (unstructured)
  resumeAnalysisId String?

  // Cached Authoritative Scores (0 - 100)
  resumeScore      Float?
  oaScore          Float?
  dsaScore         Float?
  hrScore          Float?
  compositeScore   Float?
  finalOutcomeAt   DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain             Domain?             @relation(fields: [domainId], references: [id], onDelete: SetNull)
  assessmentAttempts AssessmentAttempt[]
  interviewSessions  InterviewSession[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([domainId])
  @@index([compositeScore(sort: Desc)])
  @@index([targetDomain, compositeScore(sort: Desc)])
  @@index([status, compositeScore(sort: Desc)])
  @@map("applications")
}

model Assessment {
  id              String              @id @default(uuid())
  domainId        String
  title           String
  description     String
  durationMinutes Int                 @default(45)
  passingScore    Float               @default(70.0)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  domain          Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        AssessmentAttempt[]

  @@index([domainId, isActive])
  @@map("assessments")
}

model Question {
  id              String        @id @default(uuid())
  assessmentId    String
  type            QuestionType
  title           String
  prompt          String        @db.Text
  points          Int           @default(10)
  orderIndex      Int           @default(0)
  
  // MCQ fields
  options         String[]      // e.g. ["O(1)", "O(n)", "O(n log n)", "O(n^2)"]
  correctOption   Int?          // 0-indexed (Stripped when sending to students!)
  
  // Coding fields
  starterCode     Json?         // e.g. { "javascript": "function solution() {\n  // Code\n}", "python": "def solution():\n    pass" }
  testCases       Json?         // Array of { id, input, expectedOutput, isHidden }
  solutionCode    String?       @db.Text // Internal benchmark solution

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assessment      Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, orderIndex])
  @@map("questions")
}

model AssessmentAttempt {
  id              String          @id @default(uuid())
  assessmentId    String
  userId          String
  applicationId   String?
  status          AssessmentState @default(NOT_STARTED)
  
  // Server-authoritative timing
  startedAt       DateTime?
  expiresAt       DateTime?
  submittedAt     DateTime?

  // Scores
  mcqScore        Float?          @default(0)
  codingScore     Float?          @default(0)
  totalScore      Float?          @default(0)
  passed          Boolean         @default(false)

  // Candidate answers (Autosaved)
  // Structure: { mcq: { [questionId]: number }, code: { [questionId]: { code: string, language: string } } }
  answers         Json?

  // Detailed test results & breakdown
  // Structure: { mcqResults: [...], codingResults: [...] }
  breakdown       Json?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, assessmentId])
  @@index([status])
  @@index([applicationId, startedAt(sort: Desc)])
  @@map("assessment_attempts")
}

model InterviewSession {
  id                   String         @id @default(uuid())
  userId               String
  applicationId        String?
  type                 InterviewType  @default(DSA)
  status               SessionStatus  @default(SCHEDULED)
  
  // Multi-Question State Tracking
  currentQuestionIndex Int            @default(0)
  stage                InterviewStage @default(APPROACH)
  questionQueue        Json?          // Array of 3 questions
  questionAnswers      Json?          // { [qIndex]: { code: string, language: string, passed: boolean } }

  // Problem Details (Current Question Snapshot)
  problemTitle         String?        @default("Two Sum & Optimal Lookup")
  problemPrompt        String?        @db.Text
  currentCode          String?        @db.Text

  // Scoring
  overallScore  Float?
  
  // Cross-DB References
  transcriptId  String?       // UUID referencing MongoDB interview_transcripts
  evaluationId  String?       // UUID referencing MongoDB ai_evaluation_reports

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([applicationId, status])
  @@index([status, overallScore(sort: Desc)])
  @@map("interview_sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  targetType  String   // "APPLICATION_STATUS_OVERRIDE"
  targetId    String   // applicationId
  previousVal String?
  newVal      String
  reason      String   @db.Text
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
